{
    "name": "temporal-ai-agent",
    "version": "1.0.0",
    "description": "An AI Agent implemented using Temporal and LangChain",
    "main": "src/index.ts",
    "scripts": {
        "workflow:agent": "ts-node src/client/agent.ts",
        "claude:bug-fix": "ts-node src/claude/demo.ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "worker": "ts-node src/worker.ts",
        "server": "ts-node src/server.ts",
        "build": "tsc --noEmit",
        "temporal": "temporal server start-dev"
    },
    "keywords": [],
    "author": "Mark Repka",
    "license": "MIT",
    "dependencies": {
        "@langchain/anthropic": "^1.4.0",
        "@langchain/core": "^1.2.3",
        "@langchain/mcp-adapters": "^1.1.3",
        "@langchain/openai": "^1.5.5",
        "@temporalio/activity": "^1.21.1",
        "@temporalio/client": "^1.21.1",
        "@temporalio/worker": "^1.21.1",
        "@temporalio/workflow": "^1.21.1",
        "@temporalio/workflow-streams": "^1.21.1",
        "@types/express": "^5.0.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "langchain": "^1.5.4",
        "tiktoken": "^1.0.22",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tsconfig/node26": "^26.0.0",
        "prettier": "^3.9.6",
        "ts-node": "^10.9.2"
    },
    "engines": {
        "node": ">=26"
